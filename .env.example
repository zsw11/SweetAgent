# ============================================================
# 甜秘密跨境电商 AI Multi-Agent 系统环境变量示例
# 复制为 .env 并填写真实值，切勿提交 .env 到版本库
# ============================================================

# ---------- 应用 ----------
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ---------- LLM Provider ----------
# OpenAI
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_STRONG=gpt-4o
OPENAI_MODEL_MEDIUM=gpt-4o-mini
OPENAI_MODEL_SMALL=gpt-4o-mini

# DeepSeek
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_STRONG=deepseek-chat
DEEPSEEK_MODEL_MEDIUM=deepseek-chat
DEEPSEEK_MODEL_SMALL=deepseek-chat

# 默认 Provider（openai / deepseek）
LLM_DEFAULT_PROVIDER=deepseek

# ---------- PostgreSQL ----------
# 应用 / 写入角色（用于 schema 管理、checkpoint 写入）
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/sweetnight_agent
# Agent 只读角色（SQL Tool 统一使用，权限：仅 SELECT）
AGENT_DATABASE_URL=postgresql://agent_reader:agent_password@localhost:5432/sweetnight_agent

# ---------- LangGraph 持久化 ----------
CHECKPOINTER_TABLE=checkpoints
STORE_TABLE_PREFIX=langgraph_store

# ---------- 知识库 / 向量 ----------
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DIM=1536

# ---------- Redis（可选） ----------
REDIS_URL=redis://localhost:6379/0

# ---------- 可观测性（可选） ----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2-xxx
LANGSMITH_PROJECT=sweetnight-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
