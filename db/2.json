      "SELECT b.name AS brand_name, ps.sku_code, ps.country_code, COUNT(r.id) AS review_count, ROUND(CAST(AVG(r.rating) AS DECIMAL), 2) AS avg_rating, SUM(CASE WHEN r.rating >= 4 THEN 1 ELSE 0 END) AS positive_reviews, SUM(CASE WHEN r.rating <= 2 THEN 1 ELSE 0 END) AS negative_reviews, ROUND(CAST(100.0 * SUM(CASE WHEN r.rating >= 4 THEN 1 ELSE 0 END) / NULLIF(COUNT(r.id), 0) AS DECIMAL), 2) AS positive_rate_pct, ROUND(CAST(100.0 * SUM(CASE WHEN r.verified_purchase THEN 1 ELSE 0 END) / NULLIF(COUNT(r.id), 0) AS DECIMAL), 2) AS verified_rate_pct FROM reviews AS r JOIN product_skus AS ps ON ps.id = r.sku_id JOIN brands AS b ON b.id = ps.product_id WHERE r.country = 'US' AND r.review_date >= CAST('2026-06-18' AS DATE) AND r.review_date <= CAST('2026-09-15' AS DATE) GROUP BY b.name, ps.sku_code, ps.country_code ORDER BY review_count DESC LIMIT 5000",
