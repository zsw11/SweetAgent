      "{'requirement': 'brand_summary', 'sql': \"SELECT b.name AS brand_name, SUM(m.gmv) AS gmv, SUM(m.orders) AS orders, SUM(m.units) AS units, COUNT(DISTINCT m.sku_id) AS sku_count, COUNT(DISTINCT m.store_id) AS store_count, SUM(m.gmv) / NULLIF(SUM(m.orders), 0) AS avg_order_value, SUM(m.gmv) / NULLIF(SUM(m.units), 0) AS avg_unit_price, SUM(m.refund_amount) AS refund_amount, SUM(m.refund_amount) / NULLIF(SUM(m.gmv), 0) * 100 AS refund_rate_pct FROM mart_sales_daily AS m JOIN brands AS b ON b.id = m.brand_id WHERE m.country = 'US' AND m.date >= CAST('2026-06-18' AS DATE) AND m.date <= CAST('2026-09-15' AS DATE) GROUP BY b.name ORDER BY gmv DESC LIMIT 5000\", 'ok': True}",
      "{'requirement': 'ad', 'sql': \"SELECT c.platform, c.campaign_name, c.objective, SUM(a.impressions) AS impressions, SUM(a.clicks) AS clicks, SUM(a.spend) AS spend, SUM(a.conversions) AS conversions, SUM(a.revenue) AS revenue, ROUND(CAST(SUM(a.clicks) AS DECIMAL) / NULLIF(SUM(a.impressions), 0) * 100, 2) AS ctr_pct, ROUND(CAST(SUM(a.conversions) AS DECIMAL) / NULLIF(SUM(a.clicks), 0) * 100, 2) AS cvr_pct, ROUND(SUM(a.spend) / NULLIF(SUM(a.clicks), 0), 2) AS cpc, ROUND(SUM(a.revenue) / NULLIF(SUM(a.spend), 0), 2) AS roas FROM ad_performance_daily AS a JOIN ad_campaigns AS c ON c.id = a.campaign_id JOIN product_skus AS s ON s.id = a.sku_id WHERE s.country_code = 'US' AND a.date >= CAST('2026-06-18' AS DATE) AND a.date <= CAST('2026-09-15' AS DATE) GROUP BY c.platform, c.campaign_name, c.objective ORDER BY spend DESC LIMIT 5000\", 'ok': True}",
      "{'requirement': 'review', 'sql': \"SELECT b.name AS brand_name, ps.sku_code, ps.country_code, COUNT(r.id) AS review_count, ROUND(CAST(AVG(r.rating) AS DECIMAL), 2) AS avg_rating, SUM(CASE WHEN r.rating >= 4 THEN 1 ELSE 0 END) AS positive_reviews, SUM(CASE WHEN r.rating <= 2 THEN 1 ELSE 0 END) AS negative_reviews, ROUND(CAST(100.0 * SUM(CASE WHEN r.rating >= 4 THEN 1 ELSE 0 END) / NULLIF(COUNT(r.id), 0) AS DECIMAL), 2) AS positive_rate_pct, ROUND(CAST(100.0 * SUM(CASE WHEN r.verified_purchase THEN 1 ELSE 0 END) / NULLIF(COUNT(r.id), 0) AS DECIMAL), 2) AS verified_rate_pct FROM reviews AS r JOIN product_skus AS ps ON ps.id = r.sku_id JOIN brands AS b ON b.id = ps.product_id WHERE r.country = 'US' AND r.review_date >= CAST('2026-06-18' AS DATE) AND r.review_date <= CAST('2026-09-15' AS DATE) GROUP BY b.name, ps.sku_code, ps.country_code ORDER BY review_count DESC LIMIT 5000\", 'ok': True}",
      "SELECT p.id AS product_id, p.product_name, p.product_type, p.status AS product_status, p.launch_date, pc.name AS category_name, pc.code AS category_code, b.name AS brand_name, COUNT(DISTINCT ps.id) AS sku_count, MIN(ps.sale_price) AS min_sale_price, MAX(ps.sale_price) AS max_sale_price, ROUND(CAST(AVG((ps.sale_price - ps.cost) / NULLIF(ps.sale_price, 0) * 100) AS DECIMAL), 2) AS avg_gross_margin_pct, SUM(CASE WHEN ps.country_code = 'US' THEN 1 ELSE 0 END) AS us_sku_count, pdp.name AS dev_project_name, pdp.status AS dev_project_status, pdp.stage AS dev_project_stage, pdp.planned_launch_date AS dev_planned_launch_date FROM products AS p LEFT JOIN product_categories AS pc ON p.category_id = pc.id LEFT JOIN product_skus AS ps ON ps.product_id = p.id LEFT JOIN product_development_projects AS pdp ON pdp.brand_id = p.brand_id LEFT JOIN (SELECT 1 AS brand_id, 'SweetNight' AS name UNION ALL SELECT 2, 'Novilla' UNION ALL SELECT 3, 'Avenco' UNION ALL SELECT 4, '甜秘密') AS b ON p.brand_id = b.brand_id WHERE p.status = 'active' AND (pc.name ILIKE '%mattress%' OR pc.name ILIKE '%床垫%' OR p.product_name ILIKE '%mattress%' OR p.product_name ILIKE '%床垫%') GROUP BY p.id, p.product_name, p.product_type, p.status, p.launch_date, pc.name, pc.code, b.name, pdp.name, pdp.status, pdp.stage, pdp.planned_launch_date ORDER BY avg_gross_margin_pct DESC NULLS LAST, sku_count DESC LIMIT 500",
      "SELECT pl.sku_id, ps.sku_code, ps.country_code, pl.stage, pl.start_date, pl.end_date, pl.notes FROM product_lifecycle AS pl JOIN product_skus AS ps ON ps.id = pl.sku_id WHERE ps.country_code = 'US' ORDER BY pl.start_date DESC LIMIT 5000",
      "SELECT p.id, p.name, p.status, p.stage, p.planned_launch_date, p.actual_launch_date, p.description, b.name AS brand_name, p.created_at FROM product_development_projects AS p LEFT JOIN brands AS b ON p.brand_id = b.id WHERE p.status IN ('active', 'draft') ORDER BY p.planned_launch_date ASC LIMIT 5000",
      "SELECT r.sku_id, COUNT(*) AS review_count, ROUND(CAST(AVG(r.rating) AS DECIMAL), 2) AS avg_rating, SUM(CASE WHEN r.rating >= 4 THEN 1 ELSE 0 END) AS positive_count, SUM(CASE WHEN r.rating <= 2 THEN 1 ELSE 0 END) AS negative_count, ra.aspect, ra.sentiment, COUNT(*) AS aspect_count, ROUND(CAST(AVG(ra.score) AS DECIMAL), 2) AS avg_aspect_score FROM reviews AS r LEFT JOIN review_aspects AS ra ON ra.review_id = r.id WHERE r.country = 'US' GROUP BY r.sku_id, ra.aspect, ra.sentiment ORDER BY r.sku_id, aspect_count DESC LIMIT 5000",
      "SELECT kd.id, kd.title, kd.source_type, kd.department, kd.brand, kd.market, kd.version, kd.status, kd.created_at FROM knowledge_documents AS kd WHERE kd.market = 'US' AND kd.status = 'active' ORDER BY kd.created_at DESC LIMIT 100",
